{
    "name": "eslint-plugin-hono",
    "version": "1.3.0",
    "description": "ESLint plugin for Hono and all Hono lovers",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "ci:audit": "npm ci --ignore-scripts && npm audit signatures && npm rebuild"
    },
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "eslint-config",
        "eslint-rules",
        "hono",
        "honojs",
        "cloudflare-workers",
        "deno",
        "bun",
        "nodejs",
        "typescript",
        "linter",
        "lint",
        "code-quality",
        "static-analysis",
        "code-style",
        "biome",
        "oxlint"
    ],
    "author": "Kanon",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ouka-lab/eslint-plugin-hono.git"
    },
    "homepage": "https://github.com/ouka-lab/eslint-plugin-hono#readme",
    "bugs": {
        "url": "https://github.com/ouka-lab/eslint-plugin-hono/issues"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.9.0",
        "npm": ">=11.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@hono/cli": "^0.1.11",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.19.2",
        "@typescript-eslint/utils": "^8.66.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.8.1",
        "globals": "^16.5.0",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.66.0",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "eslint": "^9.0.0 || ^10.0.0"
    },
    "volta": {
        "node": "24.19.0",
        "npm": "11.17.0"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/ysknsid25"
    }
}
